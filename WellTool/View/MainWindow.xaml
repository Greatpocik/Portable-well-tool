<Controls:MetroWindow x:Class="WellTool.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WellTool"
        xmlns:converters="clr-namespace:WellTool.Converters"
        xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        mc:Ignorable="d"
        Title="Поиск скважин - ЦДС Помощник"
        Height="600" 
        Width="900"
        WindowStartupLocation="CenterScreen"
        GlowBrush="{DynamicResource MahApps.Brushes.AccentBase}">

    <Window.Resources>
        <!-- Конвертер для Visibility -->
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="10">

        <!-- Определяем строки Grid -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель поиска -->
        <Border Grid.Row="0" 
        Background="{DynamicResource MahApps.Brushes.Gray8}"
        Padding="10"
        CornerRadius="5">

            <StackPanel>
                <!-- Заголовок -->
                <TextBlock Text="Поиск скважин:" 
                   FontWeight="SemiBold"
                   Margin="0,0,0,10"/>

                <!-- Контейнер для динамических условий -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="SearchConditionsContainer"
                          ItemsSource="{Binding SearchConditions}">
                        <ItemsControl.ItemsPanel>
                            <!-- WrapPanel автоматически переносит элементы -->
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" 
                                   Margin="0,0,0,5"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Каждое условие поиска  -->
                                <Border Margin="0,0,10,5" 
                                Padding="5" 
                                Background="White"
                                CornerRadius="3"
                                BorderBrush="{DynamicResource MahApps.Brushes.Control.Border}" 
                                BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Выбор столбца -->
                                        <ComboBox x:Name="SearchColumnComboBox"
                                          Width="120" 
                                          Height="25"
                                          Margin="0,0,5,0"
                                          SelectedValue="{Binding Column}"
                                          SelectedValuePath="Content"
                                          Background="White"
                                          Foreground="#333333"
                                          BorderBrush="{DynamicResource MahApps.Brushes.AccentBase}">
                                            <ComboBoxItem Content="ID"/>
                                            <ComboBoxItem Content="Скважина"/>
                                            <ComboBoxItem Content="Куст"/>
                                            <ComboBoxItem Content="Цех"/>
                                            <ComboBoxItem Content="ДНС"/>
                                            <ComboBoxItem Content="Месторождение"/>
                                            <ComboBoxItem Content="Характер ЦДС"/>
                                            <ComboBoxItem Content="Фонд ОИС"/>
                                        </ComboBox>

                                        <!-- Поле для ввода значения -->
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                         Width="100" 
                                         Height="25"
                                         Padding="5"
                                         VerticalContentAlignment="Center"
                                         Background="White"
                                         Foreground="#333333"
                                         BorderBrush="{DynamicResource MahApps.Brushes.AccentBase}"
                                         CaretBrush="#333333"/>

                                        <!-- Кнопка удаления условия (кроме первого) -->
                                        <Button Content="-" 
                                        Width="20" 
                                        Height="25"
                                        Margin="5,0,0,0"
                                        Background="#FFE74C3C"
                                        Foreground="White"
                                        BorderBrush="#FFC0392B"
                                        Visibility="{Binding IsFirst, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=inverse}"
                                        Click="RemoveConditionButton_Click">
                                            <Button.Tag>
                                                <Binding/>
                                            </Button.Tag>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Панель управления условиями -->
                <StackPanel Orientation="Horizontal" 
                    Margin="0,5,0,0">
                    <!-- Кнопка добавления условия -->
                    <Button x:Name="AddConditionButton"
                    Content="+ Добавить условие" 
                    Width="130" 
                    Height="20"
                    Margin="0,0,5,0"
                    Background="{DynamicResource MahApps.Brushes.AccentBase}"
                    Foreground="White"
                    BorderBrush="{DynamicResource MahApps.Brushes.AccentBase}"
                    Click="AddConditionButton_Click"/>

                    <!-- Кнопка поиска -->
                    <Button x:Name="SearchButton"
                    Content="Поиск" 
                    Width="50" 
                    Height="20"
                    Background="#27AE60"
                    Foreground="White"
                    BorderBrush="#229954"
                    Click="SearchButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Панель с кнопкой "проверить историю" -->
        <Border Grid.Row="2" 
            Background="{DynamicResource MahApps.Brushes.Gray8}"
            Padding="5"
            CornerRadius="5">
            <StackPanel Orientation="Horizontal" 
                Margin="0,0,0,0"
                HorizontalAlignment="Left">
                <Button x:Name="CheckHistoryButton"
                Content="Проверить историю"
                Width="140"
                Height="30"
                Background="{DynamicResource MahApps.Brushes.AccentBase}"
                Foreground="White"
                BorderBrush="{DynamicResource MahApps.Brushes.AccentBase}"
                Click="CheckHistoryButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Панель для DataGrid с подложкой -->
        <!-- Панель для DataGrid с подложкой -->
        <!-- Панель для DataGrid с подложкой -->
        <Border Grid.Row="4" 
    Background="{DynamicResource MahApps.Brushes.Gray8}"
    Padding="0"
    CornerRadius="5"
    BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
    BorderThickness="1">

            <DataGrid x:Name="WellsDataGrid"
      AutoGenerateColumns="False"
      IsReadOnly="True"
      SelectionMode="Single"
      CanUserSortColumns="True"
      Background="White"
      BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
      BorderThickness="1"
      RowBackground="White"
      AlternatingRowBackground="#F8F9F9"
      Foreground="#000000"
      GridLinesVisibility="None">

                <!-- Стиль для выделения строк -->
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="#000000"/>
                                <Setter Property="BorderBrush" Value="#1976D2"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="#000000"/>
                                <Setter Property="BorderBrush" Value="#1976D2"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.ContextMenu>
                    <ContextMenu Background="White"
                       Foreground="#333333"
                       BorderBrush="{DynamicResource MahApps.Brushes.Gray7}">
                        <MenuItem Header="Пульт: Журнал событий" 
                      Click="EventJournalMenuItem_Click"/>
                        <MenuItem Header="Пульт: События из пульта" 
                      Click="PultEventsMenuItem_Click"/>
                        <Separator Background="{DynamicResource MahApps.Brushes.Gray7}"/>
                        <MenuItem Header="ТКРС: История постановки бригады" 
                      Click="BrigadeHistoryMenuItem_Click"/>
                        <MenuItem Header="ТКРС: Посуточное нахождение" 
                      Click="DailyStatusMenuItem_Click"/>
                        <Separator Background="{DynamicResource MahApps.Brushes.Gray7}"/>
                        <MenuItem Header="ГТМ: Планы" 
                      Click="GtmPlansMenuItem_Click"/>
                        <Separator Background="{DynamicResource MahApps.Brushes.Gray7}"/>
                        <MenuItem Header="Запустить проверку истории" 
                      Click="CheckDataPresenceMenuItem_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="40">
                        <DataGridTemplateColumn.Header>
                            <CheckBox x:Name="SelectAllCheckBox"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Style="{DynamicResource MahApps.Styles.CheckBox}"
                      Checked="SelectAllCheckBox_Checked"
                      Unchecked="SelectAllCheckBox_Unchecked"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Style="{DynamicResource MahApps.Styles.CheckBox}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="ID" Width="80" Binding="{Binding Id}" Foreground="#000000"/>
                    <DataGridTextColumn Header="Скважина" Width="120" Binding="{Binding Name}" Foreground="#000000"/>
                    <DataGridTextColumn Header="Куст" Width="80" Binding="{Binding Pad}" Foreground="#000000"/>
                    <DataGridTextColumn Header="Цех" Width="100" Binding="{Binding Workshop}" Foreground="#000000"/>
                    <DataGridTextColumn Header="ДНС" Width="80" Binding="{Binding DNS}" Foreground="#000000"/>
                    <DataGridTextColumn Header="Месторождение" Width="150" Binding="{Binding Field}" Foreground="#000000"/>
                    <DataGridTextColumn Header="Характер ЦДС" Width="120" Binding="{Binding CdsCharacter}" Foreground="#000000"/>
                    <DataGridTextColumn Header="Фонд ОИС" Width="100" Binding="{Binding OisFund}" Foreground="#000000"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Controls:MetroWindow>