<Controls:MetroWindow x:Class="WellTool.View.DataViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        mc:Ignorable="d"
        Title="DataViewWindow" 
        Height="500" 
        Width="800"
        WindowStartupLocation="CenterScreen"
        GlowBrush="{DynamicResource MahApps.Brushes.AccentBase}">

    <Grid Margin="10">
        <!-- Панель для DataGrid с подложкой -->
        <Border Background="{DynamicResource MahApps.Brushes.Gray8}"
                Padding="0"
                CornerRadius="5"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                BorderThickness="1">

            <DataGrid x:Name="ResultsDataGrid"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"
                      CanUserSortColumns="True"
                      Background="White"
                      BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                      BorderThickness="1"
                      RowBackground="White"
                      AlternatingRowBackground="#F8F9F9"
                      Foreground="#000000"
                      GridLinesVisibility="None">

                <!-- Стиль для выделения строк -->
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="#000000"/>
                                <Setter Property="BorderBrush" Value="#1976D2"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="#000000"/>
                                <Setter Property="BorderBrush" Value="#1976D2"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

            </DataGrid>
        </Border>
    </Grid>
</Controls:MetroWindow>